<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Undine</PackageId>
    <Description>Liquids for design, games, 3D and .NET: a water surface that moves, and the light through it from Caustikon's optics. Water first; viscous liquids and slime to follow.</Description>
    <PackageTags>water;fluids;liquids;waves;caustics;optics;shaders</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../external/caustikon/src/Caustikon/Caustikon.csproj" />
    <ProjectReference Include="../../external/caustikon/src/Caustikon.Glasses/Caustikon.Glasses.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
