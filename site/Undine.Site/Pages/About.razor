<h2>@L["about.map.h"]</h2>
<dl class="kv map">
    <dt><a href="">@L["nav.water"]</a></dt><dd>@L["about.map.water"]</dd>
    <dt><a href="liquids">@L["nav.liquids"]</a></dt><dd>@L["about.map.liquids"]</dd>
