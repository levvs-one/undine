@page "/pour"
@using System.Numerics
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inherits LocalizedComponent
@implements IDisposable

<PageTitle>@L["pour.title"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["pour.meta"]" />
</HeadContent>

<h1 class="bench-title">@L["pour.h1"]</h1>
<p class="lede">@L["pour.lede"]</p>

<div class="bench-block">
    <div class="stage">
        <canvas id="table" class="render-canvas gl water"></canvas>
        <div class="zoom-buttons">
            <button type="button" @onclick="@(() => Dolly(0.8))" aria-label="+">+</button>
            <button type="button" @onclick="@(() => Dolly(1.25))" aria-label="−">−</button>
        </div>
    </div>
    <p class="bench-hint">@(gpu ? L["pour.hint"] : L["home.nogl"])</p>
    <div class="readout compact">
        <div><div class="value">@SiteInfo.Number(poured * 1e6, 0) ml</div><div class="label">@L["pour.r.poured"]</div></div>
        <div><div class="value">@SiteInfo.Number(liquid.ViscosityMPaS, liquid.ViscosityMPaS < 10 ? 2 : 0) mPa·s</div><div class="label">@L["home.r.visc"]</div></div>
        <div><div class="value">@SiteInfo.Number(Relax * 1000, Relax < 0.1 ? 1 : 0) ms</div><div class="label">@L["pour.r.relax"]</div></div>
        <div><div class="value">@SiteInfo.Number(Capillary * 1000, 2) mm</div><div class="label">@L["pour.r.capillary"]</div></div>
        <div><div class="value">@SiteInfo.Number(Reynolds, 0)</div><div class="label">@L["pour.r.reynolds"]</div></div>
        <div><div class="value">@SiteInfo.Number(optics.NormalReflectance * 100, 2)%</div><div class="label">@L["home.r.fresnel"]</div></div>
        <div><div class="value">@fps</div><div class="label">@L["home.r.fps"]</div></div>
    </div>
    <div class="bench-controls">
        <label class="control">
            <span>@L["home.liquid"]</span>
            <select @bind="liquidName">
                @foreach (Liquid l in Liquids.All)
                {
                    <option value="@l.Name">@LiquidNames.Of(L, l)</option>
                }
            </select>
        </label>
        <RangeField Label="@L["pour.rate"]" @bind-Value="rate" Min="0.000005" Max="0.0003" Step="0.000005" Scale="1000000" Unit="ml/s" Decimals="0" />
        <RangeField Label="@L["pour.dish.depth"]" @bind-Value="dishDepth" Min="0" Max="0.05" Step="0.001" Scale="1000" Unit="mm" Decimals="0" />
        <RangeField Label="@L["pour.dish.radius"]" @bind-Value="dishRadius" Min="0.02" Max="0.2" Step="0.005" Scale="100" Unit="cm" Decimals="1" />
        <label class="control">
            <span>@L["pour.table"]</span>
            <select @bind="table">
                <option value="0">@L["pour.table.wood"]</option>
                <option value="1">@L["pour.table.stone"]</option>
                <option value="2">@L["pour.table.dark"]</option>
            </select>
        </label>
        <div class="control">
            <div class="button-row">
                <button type="button" @onclick="PourCentre">@L["pour.pour"]</button>
                <button type="button" @onclick="Empty">@L["pour.empty"]</button>
            </div>
        </div>
    </div>
    <details class="more">
        <summary>@L["ui.more"]</summary>
        <div class="bench-controls">
            <RangeField Label="@L["pour.side"]" @bind-Value="side" Min="0.2" Max="2" Step="0.05" Unit="m" Decimals="2" />
            <RangeField Label="@L["pour.tilt"]" @bind-Value="tilt" Min="0" Max="0.2" Step="0.005" Scale="100" Unit="cm/m" Decimals="1" />
            <RangeField Label="@L["pour.spout.radius"]" @bind-Value="spoutRadius" Min="0.002" Max="0.03" Step="0.001" Scale="1000" Unit="mm" Decimals="0" />
            <RangeField Label="@L["pour.spout.height"]" @bind-Value="spoutHeight" Min="0.05" Max="0.6" Step="0.01" Scale="100" Unit="cm" Decimals="0" />
            <RangeField Label="@L["home.lamp.az"]" @bind-Value="lampAzimuth" Min="-180" Max="180" Step="1" Unit="°" />
            <RangeField Label="@L["home.lamp.el"]" @bind-Value="lampElevation" Min="10" Max="89" Step="1" Unit="°" />
            <RangeField Label="@L["home.exposure"]" @bind-Value="exposure" Min="0.25" Max="4" Step="0.05" Unit="×" />
            <label class="control">
                <span>@L["home.cells"]</span>
                <select @bind="cells">
                    <option value="128">128 × 128</option>
                    <option value="256">256 × 256</option>
                    <option value="512">512 × 512</option>
                </select>
            </label>
        </div>
    </details>
</div>

<h2>@L["home.what.h"]</h2>
<p>@H("pour.what.1")</p>
<p>@H("pour.what.2")</p>
<p>@H("pour.what.3")</p>
<p>@H("pour.what.4")</p>

@code {
    private Liquid liquid = Liquids.Water;
    private LiquidOptics optics = new(Liquids.Water);
    private double rateValue = 0.00005, dishDepthValue = 0.025, dishRadiusValue = 0.08, sideValue = 0.6, tiltValue = 0, spoutRadiusValue = 0.006, spoutHeightValue = 0.25;
    // The window sits where the default camera sees it reflected in the liquid: low, across the table.
    private double lampAzimuthValue = -29, lampElevationValue = 30, exposureValue = 1;
    private int tableValue, cellsValue = 256;
    private bool gpu = true, rendered, pushQueued;
    private int fps;
    private double poured;
    private System.Threading.Timer? pollTimer;

    private string liquidName { get => liquid.Name; set { liquid = Liquids.Find(value) ?? Liquids.Water; optics = new LiquidOptics(liquid); Push(); } }
    private double rate { get => rateValue; set { rateValue = value; Push(); } }
    private double dishDepth { get => dishDepthValue; set { dishDepthValue = value; Push(); } }
    private double dishRadius { get => dishRadiusValue; set { dishRadiusValue = value; Push(); } }
    private double side { get => sideValue; set { sideValue = value; Push(); } }
    private double tilt { get => tiltValue; set { tiltValue = value; Push(); } }
    private double spoutRadius { get => spoutRadiusValue; set { spoutRadiusValue = value; Push(); } }
    private double spoutHeight { get => spoutHeightValue; set { spoutHeightValue = value; Push(); } }
    private double lampAzimuth { get => lampAzimuthValue; set { lampAzimuthValue = value; Push(); } }
    private double lampElevation { get => lampElevationValue; set { lampElevationValue = value; Push(); } }
    private double exposure { get => exposureValue; set { exposureValue = value; Push(); } }
    private int table { get => tableValue; set { tableValue = value; Push(); } }
    private int cells { get => cellsValue; set { cellsValue = value; Push(); } }

    // How long the bottom's drag takes to stop a 2 mm film: h²/(3ν).
    private double Relax => 0.002 * 0.002 / (3 * liquid.KinematicViscosity);

    // The capillary length √(σ/(ρg)): the size of a drop's rim, of the meniscus, of the ripples the flow does not carry.
    private double Capillary => Math.Sqrt(liquid.SurfaceTensionMNPerM * 1e-3 / (liquid.DensityKgPerM3 * 9.80665));

    // The stream's Reynolds number: its speed after the fall, its diameter, the liquid's viscosity.
    private double Reynolds => Math.Sqrt(2 * 9.80665 * spoutHeightValue) * 2 * spoutRadiusValue / liquid.KinematicViscosity;

    protected override void OnInitialized()
    {
        liquid = SiteInfo.ReadLiquidQuery(Navigation, Liquids.Water);
        optics = new LiquidOptics(liquid);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            rendered = true;
            await PushNowAsync();
            pollTimer = new System.Threading.Timer(async _ => await PollAsync(), null, 500, 500);
            return;
        }

        if (pushQueued)
        {
            pushQueued = false;
            await PushNowAsync();
        }
    }

    private void Push()
    {
        if (rendered)
        {
            pushQueued = true;
        }
    }

    private async Task PushNowAsync()
    {
        var spec = new
        {
            ior = new[] { optics.IndexRgb.X, optics.IndexRgb.Y, optics.IndexRgb.Z },
            alpha = new[] { optics.AbsorptionPerMetreRgb.X, optics.AbsorptionPerMetreRgb.Y, optics.AbsorptionPerMetreRgb.Z },
            kinematicViscosity = liquid.KinematicViscosity,
            rate = rateValue,
            dishX = 0.0,
            dishZ = 0.0,
            dishRadius = dishRadiusValue,
            dishDepth = dishDepthValue,
            side = sideValue,
            tilt = tiltValue,
            spoutRadius = spoutRadiusValue,
            spoutHeight = spoutHeightValue,
            cells = cellsValue,
            table = tableValue,
            lampAzimuth = lampAzimuthValue,
            lampElevation = lampElevationValue,
            lamp = 1.0,
            exposure = exposureValue,
            // The fastest the liquid is allowed to run: what a fall from the spout's height gives, and a little more.
            speedCap = Math.Sqrt(2 * 9.80665 * spoutHeightValue) + 0.5,
        };
        bool ok = await Js.InvokeAsync<bool>("undineFlow.render", "table", spec);
        if (!ok && gpu)
        {
            gpu = false;
            StateHasChanged();
        }
    }

    private async Task PollAsync()
    {
        try
        {
            int value = await Js.InvokeAsync<int>("undineFlow.fps", "table");
            double volume = await Js.InvokeAsync<double>("undineFlow.poured", "table");
            if (value != fps || Math.Abs(volume - poured) > 1e-7)
            {
                fps = value;
                poured = volume;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSException)
        {
        }
    }

    private Task PourCentre() => Js.InvokeVoidAsync("undineFlow.pourAt", "table", 0.0, 0.0, 3.0).AsTask();

    private Task Empty() => Js.InvokeVoidAsync("undineFlow.empty", "table").AsTask();

    private Task Dolly(double factor) => Js.InvokeVoidAsync("undineFlow.dolly", "table", factor).AsTask();

    public void Dispose() => pollTimer?.Dispose();
}
